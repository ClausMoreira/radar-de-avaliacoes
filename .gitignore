# Segredos: a chave da API nunca entra no repositório
.env

# Dados brutos da Olist (baixados à parte, ver README)
data/raw/*
!data/raw/.gitkeep

# Respostas do Gemini guardadas para não gastar cota de novo
data/cache/

# Planilha de trabalho da rotulagem (o gabarito final em CSV é versionado)
data/gabarito/~$*

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
