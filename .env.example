# Copie este arquivo para ".env" e preencha com a sua chave do Google AI Studio.
# O arquivo .env está no .gitignore e não deve ser enviado ao GitHub.
GEMINI_API_KEY=

# Endereço do webhook do n8n (automação). Copie do nó Webhook do fluxo.
# Trate como segredo: quem tem o endereço consegue disparar o fluxo.
N8N_WEBHOOK_URL=
